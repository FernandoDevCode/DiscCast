<Window x:Class="DiscCast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiscCast" Width="1020" Height="720" MinWidth="760" MinHeight="600"
        Style="{StaticResource AppWindow}" Background="#0D1017" Foreground="#F1F4FA"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" SourceInitialized="Window_SourceInitialized">
  <Grid x:Name="RootGrid" Margin="24,18" MaxWidth="1080">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid x:Name="HeaderPanel" Margin="0,0,18,16">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="32" Height="32" CornerRadius="8" Background="#7965EC" Margin="0,0,10,0">
          <Path Data="M 0 0 L 0 13 L 11 6.5 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="DiscCast" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <RadioButton x:Name="TransmitTab" GroupName="Page" Style="{StaticResource TabChoice}" Content="Transmitir" MinWidth="116"
                     IsChecked="True" Checked="ShowTransmit_Click" Margin="0,0,8,0"/>
        <RadioButton x:Name="WatchTab" GroupName="Page" Style="{StaticResource TabChoice}" Content="Assistir" MinWidth="106"
                     Checked="ShowWatch_Click"/>
      </StackPanel>
    </Grid>

    <Grid x:Name="TransmitPanel" Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="SettingsPanel">
          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,10,10">
            <StackPanel>
              <TextBlock Text="Fonte de vídeo" Style="{StaticResource SectionTitle}"/>
              <Grid Margin="0,3,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <RadioButton x:Name="MonitorSource" GroupName="SourceType" Content="Monitor" Style="{StaticResource TabChoice}" IsChecked="True" Checked="SourceKind_Checked"/>
                <RadioButton x:Name="WindowSource" Grid.Column="2" GroupName="SourceType" Content="Janela" Style="{StaticResource TabChoice}" Checked="SourceKind_Checked"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="SourceBox" SelectionChanged="Source_SelectionChanged" AutomationProperties.Name="Fonte de vídeo"/>
                <Button Grid.Column="2" Content="Atualizar fontes" Click="Refresh_Click"/>
              </Grid>
              <TextBlock x:Name="SourceHint" Style="{StaticResource Muted}" Visibility="Collapsed" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,10,10">
            <StackPanel>
              <TextBlock Text="Áudio da transmissão" Style="{StaticResource SectionTitle}"/>
              <ComboBox x:Name="AudioModeBox" SelectedIndex="0" SelectionChanged="AudioSettings_Changed"
                        AutomationProperties.Name="Modo de áudio" Margin="0,3,0,0">
                <ComboBoxItem Content="Sem áudio"/>
                <ComboBoxItem Content="Um aplicativo"/>
                <ComboBoxItem Content="PC sem Discord"/>
              </ComboBox>
              <ComboBox x:Name="ProcessBox" Visibility="Collapsed" Margin="0,8,0,0" DisplayMemberPath="Name"
                        AutomationProperties.Name="Aplicativo de áudio" SelectionChanged="AudioProcess_Changed"/>
              <TextBlock x:Name="AudioHint" Style="{StaticResource Muted}" Visibility="Collapsed" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,10,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
              <TextBlock Text="Qualidade de vídeo" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
              <ComboBox x:Name="QualityBox" Grid.Column="2" SelectedIndex="0" AutomationProperties.Name="Qualidade de vídeo">
                <ComboBoxItem Content="720p · 30 FPS (recomendado)"/>
                <ComboBoxItem Content="1080p · 60 FPS"/>
              </ComboBox>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border x:Name="LivePanel" Style="{StaticResource Card}" Visibility="Collapsed" VerticalAlignment="Top" Padding="20">
        <StackPanel>
          <TextBlock Text="Ao vivo" Foreground="#8BE5CB" FontSize="21" FontWeight="SemiBold"/>
          <TextBlock x:Name="LiveSource" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>
          <TextBlock x:Name="LiveDetails" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StateLabel" Text="Pronto para transmitir" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="0,0,12,0"/>
          <TextBox x:Name="RoomBox" IsReadOnly="True" Visibility="Collapsed" FontSize="12" Margin="0,0,10,0"
                   AutomationProperties.Name="Endereço da sala"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="CopyButton" Content="Copiar convite" Click="Copy_Click" Visibility="Collapsed"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button x:Name="StartButton" Content="Iniciar transmissão" Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
            <Button x:Name="StopButton" Content="Encerrar transmissão" Style="{StaticResource DangerButton}" Click="Stop_Click" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="WatchPanel" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="WatchTop" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Convite da transmissão" Style="{StaticResource SectionTitle}"/>
          <Grid Margin="0,3,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="WatchAddress" AutomationProperties.Name="Convite da transmissão" KeyDown="WatchAddress_KeyDown" TextChanged="WatchAddress_TextChanged"/>
            <Button x:Name="PasteButton" Grid.Column="2" Content="Colar" Click="Paste_Click"/>
            <Button x:Name="ConnectButton" Grid.Column="4" Content="Conectar" Style="{StaticResource PrimaryButton}" Click="Connect_Click" IsEnabled="False"/>
            <Button x:Name="DisconnectButton" Grid.Column="4" Content="Desconectar" Click="Disconnect_Click" Visibility="Collapsed"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Background="#06080C" BorderBrush="#283144" BorderThickness="1" CornerRadius="10">
        <Grid>
          <Grid x:Name="VideoHost"/>
          <TextBlock x:Name="PlayerPlaceholder" Text="Cole o convite para assistir." Style="{StaticResource Muted}"
                     FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Grid x:Name="WatchControls" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="MuteButton" Content="Silenciar" Click="Mute_Click"/>
          <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" Width="130" Margin="14,0"
                  VerticalAlignment="Center" ValueChanged="Volume_ValueChanged" AutomationProperties.Name="Volume"/>
          <TextBlock x:Name="VolumeLabel" Text="80%" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="FullscreenButton" HorizontalAlignment="Right" Content="Tela cheia" ToolTip="Pressione Esc para sair" Click="Fullscreen_Click"/>
      </Grid>
    </Grid>

    <Border x:Name="StatusPanel" Grid.Row="2" Background="#131925" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Foreground="#AEBBD1" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button Grid.Column="1" Content="Ajuda de rede" Background="Transparent" BorderThickness="0" Padding="6,0" Click="NetworkHelp_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
